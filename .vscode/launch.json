{
  "version": "0.2.0",
  "inputs": [
    {
      "type": "pickString",
      "id": "target",
      "description": "타겟 선택",
      "options": ["GSEditor.exe", "generate_compile_commands.exe"],
      "default": "generate_compile_commands.exe"
    }
  ],
  "configurations": [
    {
      "name": "launch",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/${input:target}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/debug/bin",
      "showDisplayString": true,
      "visualizerFile": "${workspaceFolder}/.natvis",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "${env:MSYS2_HOME}/mingw64/bin/gdb.exe",
      "preLaunchTask": "${input:target}",
      "internalConsoleOptions": "neverOpen",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "text": "set print unicode on",
          "ignoreFailures": true
        },
        {
          "text": "set target-charset UTF-8",
          "ignoreFailures": true
        },
        {
          "text": "set host-charset UTF-8",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
