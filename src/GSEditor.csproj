<Project>

    <PropertyGroup>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <MSBuildProjectExtensionsPath>..\build</MSBuildProjectExtensionsPath>
        <BaseIntermediateOutputPath>$(MSBuildProjectExtensionsPath)\obj\$(Configuration)</BaseIntermediateOutputPath>
        <IntermediateOutputPath>$(MSBuildProjectExtensionsPath)\obj\$(Configuration)</IntermediateOutputPath>
        <OutputPath>$(MSBuildProjectExtensionsPath)\bin\$(Configuration)</OutputPath>
    </PropertyGroup>

    <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <ApplicationManifest>Resources\App.manifest</ApplicationManifest>
        <ApplicationIcon>Resources\App.ico</ApplicationIcon>

        <NoWarn>$(NoWarn);IDE0017;IDE0060;IDE0290;SYSLIB1054;</NoWarn>
        <WarningsAsErrors>$(WarningsAsErrors);</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <SelfContained>true</SelfContained>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <PublishReadyToRun>false</PublishReadyToRun>

        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <IsTrimmable>false</IsTrimmable>
        <TrimMode>partial</TrimMode>
        <_SuppressWpfTrimError>true</_SuppressWpfTrimError>
    </PropertyGroup>

    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

    <Target Condition="'$(Configuration)' == 'Release'" Name="RunObfuscar" AfterTargets="Build">
        <Exec Command="obfuscar.console Obfuscar\Obfuscar.xml" WorkingDirectory="$(MSBuildProjectDirectory)\$(OutputPath)" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)\$(OutputPath)\Obfuscar\GSEditor.dll" DestinationFiles="$(BaseIntermediateOutputPath)\GSEditor.dll" />
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="DotNetProjects.Extended.Wpf.Toolkit" Version="5.0.129" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Embeds\**" />

        <Resource Include="Resources\**" />
        <Resource Remove="Resources\*.cs" />
        <Resource Remove="Resources\*.xaml" />
        <Resource Update="Resources\*.xaml">
            <Generator>MSBuild:Compile</Generator>
        </Resource>

        <ApplicationDefinition Remove="App.xaml" />
        <Page Include="App.xaml" />

        <None Update="Obfuscar\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>

        <None Update="*.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
