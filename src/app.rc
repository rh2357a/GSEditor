    FILESUBTYPE     0x0
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904E4"
        {
            VALUE "CompanyName", "rh2357a"
            VALUE "LegalTrademarks", "rh2357a"
            VALUE "LegalCopyright", "rh2357a"
            VALUE "ProductName", "GSEditor"
