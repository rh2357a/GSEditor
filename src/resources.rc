#include "resources.h"
#include <windows.h>

#pragma code_page(65001)

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
VS_VERSION_INFO VERSIONINFO
    PRODUCTVERSION  APP_VERSION
    FILEVERSION     APP_VERSION
    FILEOS          0x40004
    FILETYPE        0x1
    FILESUBTYPE     0x0
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904E4"
        {
            VALUE "CompanyName", APP_AUTHOR
            VALUE "LegalTrademarks", APP_AUTHOR
            VALUE "LegalCopyright", APP_AUTHOR
            VALUE "ProductName", APP_NAME
            VALUE "FileDescription", "포켓몬스터 금 버전 에디터"
            VALUE "ProductVersion", APP_VERSION_STR
            VALUE "OriginalFilename", APP_FILENAME
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x412, 1200
    }
}

RES_ID_APP_MANIFEST RT_MANIFEST "app.exe.manifest"

RES_ID_APP_ICON     ICON        "app.ico"

RES_ID_RGBASM       RCDATA      "sidecar/rgbasm.exe"
RES_ID_RGBLINK      RCDATA      "sidecar/rgblink.exe"
RES_ID_RGBFIX       RCDATA      "sidecar/rgbfix.exe"
