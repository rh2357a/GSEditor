<Window x:Class="GSEditor.UI.Dialogs.MainDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:dialogs="clr-namespace:GSEditor.UI.Dialogs"
                 d:DataContext="{d:DesignInstance Type=dialogs:MainDialogViewModel}"
                 mc:Ignorable="d"
                 Title="{Binding Title}">

    <TabControl Style="{DynamicResource MahApps.Styles.TabControl.AnimatedSingleRow}">
        <TabItem Header="one">
        </TabItem>
        <TabItem Header="two (테스트)">
            <StackPanel Orientation="Vertical">
                <Button  Content="about"
                         Command="{Binding TestAboutCommand}" />
                <Button  Content="bad"
                         Command="{Binding TestBadCommand}" />
            </StackPanel>
        </TabItem>
        <TabItem Header="three"></TabItem>
    </TabControl>

</Window>
